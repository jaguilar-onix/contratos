# Copia este archivo como .env y llena los tres valores.
# El .env no se sube al repositorio.

# Dominio o subdominio que apunta al VPS. Su registro A debe existir ANTES de
# levantar los contenedores: Caddy pide el certificado al arrancar.
DOMINIO=contratos.onixliving.mx

# Usuario para entrar a la aplicacion.
USUARIO=onix

# Contrasena cifrada. Generala en el servidor con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-contrasena'
# y pega aqui la linea que devuelve (empieza con $2a$).
# Ojo: dentro de este archivo, cada $ debe escribirse $$.
CLAVE_HASH=
