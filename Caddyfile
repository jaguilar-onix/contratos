# Solo resuelve el certificado HTTPS y pasa el trafico a la aplicacion.
# La contrasena de acceso la pide la propia aplicacion (ACCESO_USUARIO y
# ACCESO_CLAVE), de modo que es la misma en cualquier forma de desplegarla.
{$DOMINIO} {
	encode zstd gzip

	# Un anexo escaneado pesa mas que el limite por omision de Caddy.
	request_body {
		max_size 30MB
	}

	reverse_proxy contratos:3000
}
